{
  "color": {
    "primary":    { "$value": "var(--color-brand-500)",       "$type": "color" },
    "primary-lt": { "$value": "var(--color-brand-400)",       "$type": "color" },
    "accent":     { "$value": "var(--color-blue-light-500)",  "$type": "color" },
    "success":    { "$value": "var(--color-success-500)",     "$type": "color" },
    "error":      { "$value": "var(--color-error-500)",       "$type": "color" },
    "warning":    { "$value": "var(--color-warning-500)",     "$type": "color" },
    "brand": {
      "primary":       { "$value": "var(--color-teal-600)",   "$type": "color" },
      "primary-hover": { "$value": "var(--color-teal-700)",   "$type": "color" },
      "primary-subtle":{ "$value": "var(--color-teal-50)",    "$type": "color" },
      "secondary":     { "$value": "var(--color-teal-500)",   "$type": "color" },
      "accent":        { "$value": "var(--color-teal-400)",   "$type": "color" }
    },
    "status": {
      "active":   { "$value": "var(--color-emerald-500)", "$type": "color" },
      "bench":    { "$value": "var(--color-amber-400)",   "$type": "color" },
      "warning":  { "$value": "var(--color-orange-500)",  "$type": "color" },
      "complete": { "$value": "var(--color-slate-400)",   "$type": "color" },
      "planned":  { "$value": "var(--color-sky-500)",     "$type": "color" }
    }
  }
}
