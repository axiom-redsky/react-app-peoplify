{
  "name": "peoplify-server",
  "version": "1.0.0",
  "description": "Peoplify API Server",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "dev:nas": "dotenv -e .env.nas -- nodemon src/index.js",
    "dev:remote": "dotenv -e .env.remote -- nodemon src/index.js",
    "dev:vultr": "dotenv -e .env.vultr -- nodemon src/index.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:nas": "dotenv -e .env.nas -- knex migrate:latest",
    "migrate:remote": "dotenv -e .env.remote -- knex migrate:latest",
    "migrate:vultr": "dotenv -e .env.vultr -- knex migrate:latest",
    "seed": "knex seed:run",
    "seed:nas": "dotenv -e .env.nas -- knex seed:run",
    "seed:remote": "dotenv -e .env.remote -- knex seed:run",
    "seed:vultr": "dotenv -e .env.vultr -- knex seed:run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "nodemon": "^3.1.0"
  }
}
